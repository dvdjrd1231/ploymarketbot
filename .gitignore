# ---------------------------------------------------------------------------
# Polymarket Bot — repository root
#
# Layout:
#   Polymarket-Bot-DAVID/       the deliverable — source for three projects
#     ploymarketbot/            copy-trading bot (FastAPI + React dashboard)
#     polymarket-quant-bridge/  quant research/execution engine (pqb)
#     qc_lean_bridge/           QuantConnect LEAN bridge
#   Polymarket-Bot-DATA/        runtime state only — never committed
#
# Rule of thumb: code, docs and *.example templates are tracked; anything the
# apps write at run time (databases, journals, logs, exports, reports) is not.
# ---------------------------------------------------------------------------

# --- Runtime data root -------------------------------------------------------
# Live databases, rotated logs and per-market research exports written by the
# running bot. Per-deployment state, and it holds trading history — keep it out
# of the repo entirely.
Polymarket-Bot-DATA/

# --- Secrets -----------------------------------------------------------------
# Private keys live in the OS keyring or a chmod-600 .env, never in the tree.
# These patterns are a safety net for keys copied here while debugging.
.env
.env.*
*.env
!*.env.example
!.env.example
/Polymarket-Bot-DAVID/ploymarketbot/deploy/*.env
secret.bin
secret.enc
*.pem
*.key
*.p12
*.pfx

# The operator's filled-in config. config.example.yaml is the tracked template.
/Polymarket-Bot-DAVID/polymarket-quant-bridge/config/config.yaml
config.json

# --- Runtime state: databases and journals -----------------------------------
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
/Polymarket-Bot-DAVID/polymarket-quant-bridge/state/

# Backup archives written by the compose `backup` service — these contain the
# journal and the intel store, so they must never reach a repository.
backups/
*.tar.gz

# --- Runtime state: logs, reports, generated strategies -----------------------
*.log
*.log.[0-9]
*.jsonl
bot.log
/Polymarket-Bot-DAVID/qc_lean_bridge/logs/
/Polymarket-Bot-DAVID/qc_lean_bridge/reports/
/Polymarket-Bot-DAVID/qc_lean_bridge/strategies/
/Polymarket-Bot-DAVID/qc_lean_bridge/data/
/Polymarket-Bot-DAVID/qc_lean_bridge/sample_data/exports/
/Polymarket-Bot-DAVID/qc_lean_bridge/sample_data/ticks.csv

# Support screenshots are a drop folder; keep the folder, not the images.
/Polymarket-Bot-DAVID/screenshots/*
!/Polymarket-Bot-DAVID/screenshots/README.txt

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Virtual environments (DEPLOY.md creates .venv on the VPS)
.venv/
venv/
ENV/
env/
.python-version

# PyInstaller output (qc_lean_bridge/build.spec, build.ps1)
dist/
*.manifest
*.spec.bak

# Tooling caches
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/
*.zip

# --- Frontend (React + TypeScript + Vite) ------------------------------------
node_modules/

# Build output. Regenerated by `npm run build`, which run.py triggers on first
# start; DEPLOY.md step 5 builds it on the VPS (or copies a local build).
/Polymarket-Bot-DAVID/ploymarketbot/frontend/dist/

.vite/
*.tsbuildinfo
vite.config.ts.timestamp-*

# npm / yarn / pnpm noise — lockfiles themselves stay tracked on purpose, so
# `npm ci` reproduces the exact dashboard build.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnp.*

# --- Editors / IDE / agent tooling -------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/
*.lock
!package-lock.json

# --- OS ----------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# --- Misc --------------------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
*.pid
