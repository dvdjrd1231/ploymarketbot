# ---------------------------------------------------------------------------
# Polymarket Copy Trading Bot
# ---------------------------------------------------------------------------

# --- Secrets -----------------------------------------------------------------
# The private key normally lives in the OS keyring or in %APPDATA% /
# ~/PolymarketBotWeb, never in the repo. These patterns are a safety net in case
# a data directory is ever pointed at the working tree, or a key file is copied
# here while debugging. Never commit any of them.
secret.bin
secret.enc
*.env
.env
.env.*
!*.env.example
/deploy/*.env

# --- Runtime data ------------------------------------------------------------
# Database, settings and log written by the app. Settings hold the funder
# address and target wallet, so they are per-deployment, not shared code.
config.json
bot.log
*.log
copybot.sqlite3
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Virtual environments (DEPLOY.md creates .venv on the VPS)
.venv/
venv/
ENV/
env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/

# --- Frontend (React + TypeScript + Vite) ------------------------------------
node_modules/

# Build output. Regenerated by `npm run build`, which run.py triggers on first
# start; DEPLOY.md step 5 builds it on the VPS (or copies a local build).
/frontend/dist/

.vite/
*.tsbuildinfo
vite.config.ts.timestamp-*

# npm / yarn / pnpm noise — lockfiles themselves stay tracked on purpose, so
# `npm ci` reproduces the exact dashboard build.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnp.*

# --- Editors / IDE -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# --- OS ----------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# --- Misc --------------------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
*.pid
