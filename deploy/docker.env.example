# Copy to .env in the project root (next to docker-compose.yml):
#
#   cp deploy/docker.env.example .env
#   openssl rand -base64 32          # paste the output below
#   chmod 600 .env
#
# .env is gitignored. Docker Compose reads it automatically.

# Unlocks the AES-256-GCM keyfile holding your wallet private key. Inside the
# container the file is /data/PolymarketBotWeb/secret.enc, which lives on the
# `botdata` volume. Required for live trading; unused in paper mode.
#
# Back this up somewhere other than the VPS. If it is lost or changed, secret.enc
# can no longer be decrypted and you must re-enter the private key.
POLYBOT_SECRET_PASSPHRASE=replace-me-with-a-long-random-passphrase
