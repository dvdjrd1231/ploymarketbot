# Environment for the Polymarket bot service.
#
#   sudo cp deploy/polymarketbot.env.example /etc/polymarketbot.env
#   sudo chown root:root /etc/polymarketbot.env
#   sudo chmod 600 /etc/polymarketbot.env
#   sudo nano /etc/polymarketbot.env     # put a real passphrase in
#
# Generate one with:  openssl rand -base64 32

# Unlocks the AES-256-GCM keyfile (~/PolymarketBotWeb/secret.enc) that holds
# your wallet private key. Required for LIVE trading on a headless server,
# where no OS keyring daemon is available. Not needed for paper trading.
#
# Losing this passphrase means secret.enc can no longer be decrypted — you would
# re-enter the private key in the dashboard. Changing it has the same effect, so
# back it up somewhere that is not this VPS.
POLYBOT_SECRET_PASSPHRASE=replace-me-with-a-long-random-passphrase
