+        # An empty snapshot while positions are held is far more likely to be
+        # a broken source than an empty book. Recorded so the guard can weigh
+        # the absence rather than trust it.
+        source_healthy = not (len(actual) == 0 and len(lifecycles) > 0)
 
@@ the "position.missing" branch
