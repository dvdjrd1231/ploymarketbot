# Copy to the project root as .env before `docker compose up`.
#
#   cp deploy/docker/pqb.env.example .env
#   chmod 600 .env
#
# LEAVE THE KEY BLANK until you are ready to trade live. Dry-run needs neither
# of the first two values, and the container refuses to start in live mode with
# an empty key rather than running and rejecting every order.
#
# This file is a SECRET. It is in .gitignore, never enters an image layer, and
# is never included in a backup archive.

# --- credentials (live trading only) ---------------------------------------
PQB_PRIVATE_KEY=
PQB_FUNDER_ADDRESS=

# --- image ------------------------------------------------------------------
# Override to pin a build, e.g. pqb:2026-08-11
PQB_IMAGE=pqb:latest
