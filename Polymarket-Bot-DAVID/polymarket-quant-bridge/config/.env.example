# Copy to the PROJECT ROOT as `.env` and fill in. Never commit it.
#
#   cp config/.env.example .env
#   chmod 600 .env            # Linux/macOS
#
# Only referenced by ${env:...} entries in config.yaml. Nothing here is ever
# written to a log, the journal, or any report.

# Wallet private key: 64 hex characters, with or without the 0x prefix.
# Required only for live trading — dry-run needs no key at all.
PQB_PRIVATE_KEY=

# Only for Polymarket email (signature_type 1) or browser-proxy (2) wallets:
# the Polymarket deposit address that actually holds the USDC. Leave empty for
# a plain EOA, where the signer is the funder.
PQB_FUNDER_ADDRESS=

# Optional: Polygon JSON-RPC endpoint for on-chain CTF reconstruction (true
# per-wallet P&L including merges and redemptions). A public endpoint works but
# is rate-limited; a provider URL (Alchemy/Infura/QuickNode) gives deep history.
# Left empty, on-chain reconstruction is simply disabled.
# PQB_POLYGON_RPC_URL=https://polygon-rpc.com

# Optional: where the ploymarketbot project is checked out. Defaults to
# ../ploymarketbot relative to this project.
# PQB_POLYMARKETBOT_PATH=D:\git_olaf\ploymarketbot
