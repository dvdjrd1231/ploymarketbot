# Secrets — never commit
.env
*.pem
*.key

# Runtime state: journal, intel store, logs, kill switch, paper book
state/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.log

# Backup archives written by the compose `backup` service — these contain the
# journal and the intel store, so they must never reach a repository.
backups/
*.tar.gz

# The operator's own config (config.example.yaml is the tracked template)
config/config.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
*.zip
